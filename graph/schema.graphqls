# GraphQL schema example
#
# https://gqlgen.com/getting-started/

scalar Upload

  # Edit by CODEX: rule draft for UI (no templateId yet)
  type RuleDraft {
    sourceType: String!
    sourceKey: String!
    targetLabel: String!
    transform: String
    required: Boolean!
  }

  type DraftFromExcelPayload {
    headers: [String!]!
    # Edit by CODEX: preview cells are always string; empty cell becomes "".
    sampleRows: [[String!]!]!
    draftRules: [RuleDraft!]!
  }

  type Template {
    id: ID!
    name: String!
    target: String!
    sheetName: String
    headerRow: Int!
    dataStartRow: Int!
    notes: String
    createdAt: String
    updatedAt: String
  }

  type Rule {
    id: ID!
    templateId: ID!
    sourceType: String!
    sourceKey: String!
    targetID: String!
    targetLabel: String!
    canonicalKey: String
    transform: String
    required: Boolean!
    priority: Int
    evidence: String
    createdAt: String!
    updatedAt: String!
  }

  type Query {
    templates: [Template!]!
    template(name: String!): Template
    rules(templateId: ID!): [Rule!]!
  }

  input CreateTemplateInput {
    name: String!
    sheetName: String
    headerRow: Int!
    dataStartRow: Int!
  }

  input CreateRuleInput {
    templateId: ID!
    sourceKey: String!
    sourceType: String!
    targetLabel: String!
    transform: String
    required: Boolean!
  }
  
  input UpdateTemplateInput {
    name: String
    sheetName: String
    headerRow: Int
    dataStartRow: Int
  }

  input UpdateRuleInput{
    sourceKey: String
    sourceType: String
    targetLabel: String
    transform: String
    required: Boolean
  }

  type Mutation {
    createTemplate(input: CreateTemplateInput!): Template!
    updateTemplate(id: ID!, input: UpdateTemplateInput!): Template!
    
    createRule(input: CreateRuleInput!): Rule!
    updateRule(id: ID!, input: UpdateRuleInput!): Rule!

    # Edit by CODEX: Excel upload (PoC: return JSON as string)
    processExcel(templateName: String!, file: Upload!): String!
    processExcelOnly(file: Upload!): String!

    draftRulesFromExcel(file: Upload!): DraftFromExcelPayload!
  }
